# ── Supabase (browser-safe, used by the ordering UI + admin) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Server-only (NEVER prefixed NEXT_PUBLIC) ──
# Used by /api/recommend to read order history + call the LLM
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENROUTER_API_KEY=sk-or-your-openrouter-key
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# ── n8n (WhatsApp notifications) ──
# Webhook URL from your n8n Webhook node, e.g. https://n8n.srv1771923.hstgr.cloud/webhook/slicematic-order
N8N_WEBHOOK_URL=
